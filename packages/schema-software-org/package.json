{
  "name": "@equationalapplications/schema-software-org",
  "version": "6.1.0",
  "description": "Custom minimal ontology manifest for an executive agent operating on behalf of a software organization: 17 node types, 40 edges, warm-agent superset. Data-only.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "ontology",
    "knowledge-graph",
    "llm-memory",
    "ai-memory",
    "software-organization",
    "codemeta",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/equationalapplications/expo-llm-wiki.git",
    "directory": "packages/schema-software-org"
  },
  "bugs": {
    "url": "https://github.com/equationalapplications/expo-llm-wiki/issues"
  },
  "homepage": "https://github.com/equationalapplications/expo-llm-wiki/tree/main/packages/schema-software-org#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@equationalapplications/core-llm-wiki": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@equationalapplications/schema-org-llm-wiki": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  }
}
