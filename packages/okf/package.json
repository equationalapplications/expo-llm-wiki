{
  "name": "@equationalapplications/core-okf",
  "version": "7.1.0",
  "description": "Zero-dependency Open Knowledge Format (OKF) v0.1 + v0.2 primitives: frontmatter serialization (with flow mappings / sequences), concept documents, index.md and log.md builders, trust-tier and staleness helpers.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "okf",
    "open-knowledge-format",
    "markdown",
    "frontmatter",
    "knowledge-graph",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/equationalapplications/expo-llm-wiki.git",
    "directory": "packages/okf"
  },
  "bugs": {
    "url": "https://github.com/equationalapplications/expo-llm-wiki/issues"
  },
  "homepage": "https://github.com/equationalapplications/expo-llm-wiki/tree/main/packages/okf#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  }
}
